# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference screen recording (too big for GitHub)
/docs/reference/video/
/docs/reference/**/*.mov
/docs/reference/**/*.mp4

# extracted reference / measurement frames (large, regenerable)
/docs/reference/work-frames/
/docs/reference/work-frames-ours/
/docs/reference/work-masks/

# A source model (not served; scripts/build-spine.mjs reads it)
public/models/spine-raw.glb
